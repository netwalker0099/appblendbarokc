# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=blendbar
POSTGRES_PASSWORD=changeme
POSTGRES_DB=blendbar
DATABASE_URL=postgres://blendbar:changeme@db:5432/blendbar

# --- Square (server-side only, never sent to the browser) ---
# Square is the billing system: carts are pushed to it as an order + hosted
# payment link, the customer pays on Square's page, and the result comes back by
# webhook. No card data ever touches this box.
#
# 'sandbox' (default) or 'production'. Sandbox and production have completely
# separate credentials — a sandbox token will 401 against production.
# ALWAYS take a full test payment in sandbox before switching this.
SQUARE_ENV=sandbox
# Access token from the Square developer dashboard, for the environment above.
# Unset => the app falls back to an in-process mock and charges nobody.
SQUARE_ACCESS_TOKEN=
# The Square location to sell against. REQUIRED alongside the token — Square
# rejects an order without it, so the app refuses to go live on a token alone.
# Find it under Square Dashboard > Locations, or GET /v2/locations.
SQUARE_LOCATION_ID=
# Where Square sends the customer's browser after a successful payment.
# Optional; leave blank to keep them on Square's confirmation page.
SQUARE_REDIRECT_URL=
#
# --- Square webhooks ---
# Both of the next two are required, or the receiver stays disabled (503).
# Signature key shown when you create the webhook subscription in Square.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# The notification URL EXACTLY as entered in the Square dashboard. Square signs
# (url + body), so a mismatch here — even a trailing slash — fails every
# signature check. It is configured rather than inferred from request headers
# because Host is attacker-controlled.
SQUARE_WEBHOOK_URL=https://app.theblendbarokc.com/api/webhooks/square

# --- Domain served by Caddy (must have DNS pointed at this host before TLS will issue) ---
DOMAIN=app.theblendbarokc.com

# Dev-only: an email that can sign into the customer portal without a magic link.
# Leave BLANK in production.
PORTAL_BYPASS_EMAIL=

# --- Email: Google Workspace SMTP relay ---
# Google's documented path for a server application sending as a Workspace
# domain. Set up in Google Admin:
#   Apps > Google Workspace > Gmail > Routing > SMTP relay service
#   - Allowed senders: "Only addresses in my domains"
#   - Authentication: tick "Only accept mail from the specified IP addresses"
#     and add this server's public IP. With IP allowlisting there is NO username
#     or password to store, which is why it is preferred here.
#   - Encryption: tick "Require TLS encryption"
# Unset SMTP_HOST => the app uses a mock that logs mail instead of sending, and
# nobody can sign in to the customer portal.
SMTP_HOST=
SMTP_PORT=587
# Only if you also enable "Require SMTP Authentication" on the relay. Both must
# be set together or the app refuses to start the transport. Avoid app passwords
# where IP allowlisting will do: they cannot be scoped and grant full send rights.
SMTP_USERNAME=
SMTP_PASSWORD=

# Public site root, used to build links in customer email (sign-in, portal).
CUSTOMER_SITE_URL=https://sandbox.theblendbarokc.com
