# Shared security headers, applied to both vhosts.
(security_headers) {
	header {
		# Force HTTPS for a year (this host is TLS-only via Caddy).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# style 'unsafe-inline' covers inline style attributes (Vue :style / static
		# markup); scripts stay 'self' only.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Don't advertise the server software.
		-Server
	}
}

# Operator app (intake / lookup / admin).
{$DOMAIN} {
	import security_headers

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}

	encode gzip
}

# Public customer-facing marketing site + (future) customer portal.
# TLS issues automatically once the DNS record for this host resolves.
sandbox.theblendbarokc.com {
	import security_headers

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /usr/share/blendbar-site
		# {path}/index.html serves /portal (portal/index.html); {path}.html serves
		# /portal/verify (portal/verify.html).
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}

	encode gzip
}
