# Shared security headers, applied to both vhosts.
(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# style 'unsafe-inline' covers inline style attributes (Vue :style / static
		# markup); scripts stay 'self' only.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Don't advertise the server software.
		-Server
	}
}

# Operator app (intake / lookup / admin).
{$DOMAIN} {
	import security_headers
	# Force HTTPS for a year (this host is TLS-only via Caddy).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html

		# Cache policy, split by whether a filename identifies its own contents.
		#
		# Vite fingerprints everything under /assets (index-<hash>.js), so those
		# can be kept forever — a new build produces a new name.
		#
		# index.html is NOT fingerprinted: it is the file that says which bundle
		# to load. Served with no Cache-Control at all, browsers fall back to
		# heuristic freshness and can hold a stale copy for days, so a user keeps
		# running the previous build after a deploy and sees none of the changes.
		# That is exactly what happened on 2026-07-27. `no-cache` still permits
		# caching, it only forces revalidation — the cost is one 304 per load.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@notassets not path /assets/*
		header @notassets Cache-Control "no-cache"

		file_server
	}

	encode gzip
}

# Public customer-facing marketing site + (future) customer portal.
# TLS issues automatically once the DNS record for this host resolves.
sandbox.theblendbarokc.com {
	import security_headers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	handle /api/* {
		reverse_proxy api:8080
	}

	# Shareable scent links: /s/<id> serves the public scent page (share.js reads
	# the id from the path).
	handle /s/* {
		root * /usr/share/blendbar-site
		rewrite * /share.html
		file_server
	}

	# One page per shop item: /shop/<id> serves shop.html, which reads the id
	# from the path. /shop itself still resolves to shop.html via try_files.
	handle /shop/* {
		root * /usr/share/blendbar-site
		rewrite * /shop.html
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /usr/share/blendbar-site
		# {path}/index.html serves /portal (portal/index.html); {path}.html serves
		# /portal/verify (portal/verify.html).
		try_files {path} {path}.html {path}/index.html /index.html

		# This site is hand-written, so only the images carry stable names —
		# styles.css, share.js and portal/app.js are edited in place and MUST
		# revalidate, or a fix ships and returning visitors never see it.
		@img path /assets/*
		header @img Cache-Control "public, max-age=604800"

		@code not path /assets/*
		header @code Cache-Control "no-cache"

		file_server
	}

	encode gzip
}

# Production customer site: a promoted copy of the sandbox (site-prod/, see
# README "Promoting the sandbox site"). Same API, same routes as the sandbox.
theblendbarokc.com {
	import security_headers
	# No includeSubDomains here: on the apex it would force HTTPS on every
	# subdomain of the business domain, including ones this box doesn't serve.
	header Strict-Transport-Security "max-age=31536000"

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /s/* {
		root * /usr/share/blendbar-site-prod
		rewrite * /share.html
		file_server
	}

	# One page per shop item: /shop/<id> serves shop.html, which reads the id
	# from the path. /shop itself still resolves to shop.html via try_files.
	handle /shop/* {
		root * /usr/share/blendbar-site-prod
		rewrite * /shop.html
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /usr/share/blendbar-site-prod
		try_files {path} {path}.html {path}/index.html /index.html

		@img path /assets/*
		header @img Cache-Control "public, max-age=604800"

		@code not path /assets/*
		header @code Cache-Control "no-cache"

		file_server
	}

	encode gzip
}

www.theblendbarokc.com {
	redir https://theblendbarokc.com{uri} permanent
}
